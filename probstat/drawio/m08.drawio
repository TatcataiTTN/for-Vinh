<mxfile host="app.diagrams.net"><diagram name="p1" id="d1"><mxGraphModel dx="1000" dy="560" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="Chọn công thức khoảng tin cậy" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontFamily=PT Sans;fontColor=#1d2433;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="960" height="34" as="geometry"/></mxCell><mxCell id="n4" value="Đọc đề: tham số cần ước lượng là gì? biến có chuẩn không? σ đã biết không? mẫu có lớn không?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontFamily=PT Sans;fontColor=#5d6678;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="960" height="24" as="geometry"/></mxCell><mxCell id="n5" value="Ước lượng tham số nào?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4e8c;strokeColor=#14325a;fontSize=17;fontFamily=PT Sans;fontColor=#ffffff;fontStyle=1;arcSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="240" height="60" as="geometry"/></mxCell><mxCell id="n6" value="Kỳ vọng μ&#10;(biến chuẩn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontFamily=PT Sans;fontColor=#1d2433;fontStyle=1;arcSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="260" height="64" as="geometry"/></mxCell><mxCell id="n7" value="Tỷ lệ p&#10;(n lớn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontFamily=PT Sans;fontColor=#1d2433;fontStyle=1;arcSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="370" y="210" width="260" height="64" as="geometry"/></mxCell><mxCell id="n8" value="Phương sai σ²&#10;(mở rộng, chuẩn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;fontFami