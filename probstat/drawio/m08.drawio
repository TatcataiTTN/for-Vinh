 = tần suất mẫu&#10;U = U(α/2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontFamily=PT Sans;fontColor=#1d2433;fontStyle=1;arcSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="360" width="240" height="80" as="geometry"/></mxCell><mxCell id="n15" value="[(n−1)s²/χ²(α/2); (n−1)s²/χ²(1−α/2)]&#10;bậc tự do n − 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontFamily=PT Sans;fontColor=#1d2433;fontStyle=1;arcSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="360" width="280" height="80" as="geometry"/></mxCell><mxCell id="n16" value="σ biết" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f4e8c;fontSize=14;fontFamily=PT Sans;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="σ chưa biết" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f4e8c;fontSize=14;fontFamily=PT Sans;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f4e8c;fontSize=14;fontFamily=PT Sans;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f4e8c;fontSize=14;fontFamily=PT Sans;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="Cỡ mẫu: n ≥ (2·U·σ/L)²  (độ dài L)   |   Độ tin cậy ↑ ⇒ khoảng rộng hơn   |   n ↑ ⇒ khoảng hẹp hơn (theo 1/√n)   |   Đề Phenikaa: dữ liệu theo lớp ⇒ dùng điểm giữa lớp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontFamily=PT Sans;fontColor=#1d2433;fontStyle=1;arcSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="10" y="470" width="980" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>