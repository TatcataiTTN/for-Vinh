or=#1f4e8c;fontSize=14;fontFamily=PT Sans;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f4e8c;fontSize=14;fontFamily=PT Sans;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f4e8c;fontSize=14;fontFamily=PT Sans;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="Có: bác bỏ H₀,&#10;thừa nhận H₁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=17;fontFamily=PT Sans;fontColor=#1d2433;fontStyle=1;arcSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="250" width="300" height="90" as="geometry"/></mxCell><mxCell id="n18" value="Không: chưa đủ cơ sở&#10;bác bỏ H₀ (chấp nhận H₀)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;fontFamily=PT Sans;fontColor=#1d2433;fontStyle=1;arcSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="690" y="250" width="300" height="90" as="geometry"/></mxCell><mxCell id="n19" value="T_qs ∈ W_α" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f4e8c;fontSize=14;fontFamily=PT Sans;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="T_qs ∉ W_α" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f4e8c;fontSize=14;fontFamily=PT Sans;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="σ đã biết:&#10;T = (x̄ − μ₀)/(σ/√n) ~ N(0,1)&#10;H₁ &gt;: T &gt; U_α&#10;H₁ &lt;: T &lt; −U_α&#10;H₁ ≠: |T| &gt; U(α/2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontFamily=PT Sans;fontColor=#1d2433;fontStyle=1;arcSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="300" height="150" as="geometry"/></mxCell><mxCell id="n22" value="σ chưa biết:&#10;T = (x̄ − μ₀)/(s/√n) ~ t(n−1)&#10;H₁ &gt;: T &gt; t_α&#10;H₁ &lt;: T &lt; −t_α&#10;H₁ ≠: |T| &gt; t(α/2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontFamily=PT Sans;fontColor=#1d2433;fontStyle=1;arcSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="350" y="410" width="300" height="150" as="geometry"/></mxCell><mxCell id="n23" value="Hai sai lầm:&#10;Loại I: bác bỏ H₀ đúng, xác suất α&#10;Loại II: nhận H₀ sai, xác suất β&#10;Lực lượng η = 1 − β" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontFamily=PT Sans;fontColor=#1d2433;fontStyle=1;arcSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="680" y="410" width="300" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>