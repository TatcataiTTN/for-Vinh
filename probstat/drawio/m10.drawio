<mxfile host="app.diagrams.net"><diagram name="p1" id="d1"><mxGraphModel dx="1000" dy="640" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="Quy trình kiểm định giả thuyết (7 bước)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontFamily=PT Sans;fontColor=#1d2433;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="960" height="34" as="geometry"/></mxCell><mxCell id="n4" value="1  H₀: θ = θ₀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontFamily=PT Sans;fontColor=#1d2433;fontStyle=1;arcSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="125" height="80" as="geometry"/></mxCell><mxCell id="n5" value="2  H₁: θ &lt;, ≠, &gt; θ₀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontFamily=PT Sans;fontColor=#1d2433;fontStyle=1;arcSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="158" y="90" width="125" height="80" as="geometry"/></mxCell><mxCell id="n6" value="3  Chọn mức ý nghĩa α&#10;(5%, 1%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontFamily=PT Sans;fontColor=#1d2433;fontStyle=1;arcSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="296" y="90" width="125" height="80" as="geometry"/></mxCell><mxCell id="n7" value="4  Tiêu chuẩn T&#10;(U hay t? χ²?)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontFamily=PT Sans;fontColor=#1d2433;fontStyle=1;arcSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="434" y="90" width="125" height="80" as="geometry"/></mxCell><mxCell id="n8" value="5  Miền bác bỏ W_α" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontFamily=PT Sans;fon